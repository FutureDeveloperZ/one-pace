{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true,
    "noEmit": true,
    "types": ["./src/seanime.d.ts"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "code.ts", "code.js"]
}
